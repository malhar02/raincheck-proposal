var M=[["Home market (sample)",4000,22000,9000,600,1500,400000],["Metro market (sample)",3000,24000,9000,1800,3500,1500000],["Duty-free channel (sample)",1500,26000,9000,2200,2000,800000],["New dry-state market (sample)",800,20000,9000,3500,3000,2500000]];
function run(){
