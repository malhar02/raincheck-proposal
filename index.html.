<script>
(function(){
var d=document.getElementById('drops');
for(var i=0;i<26;i++){var e=document.createElement('i');e.style.left=(i*3.9+Math.random()*2)+'%';e.style.animationDuration=(3+Math.random()*4)+'s';e.style.animationDelay=(-Math.random()*6)+'s';d.appendChild(e)}
var fmt=function(n){return n.toLocaleString('en-IN')};
var cap=[["Reported annual sales",20000,"var(--rain)"],["Reported current capacity",22000,"var(--steel)"],["5× capacity scenario",110000,"var(--moss)"],["Volume to fill above sales",90000,"var(--berry)"]];
